{% extends "base.html" %}
{% block title %}Inicio{% endblock %}

{% block content %}
<div class="text-center py-4">
    <h1 style="font-family:'Playfair Display',serif;
               color:var(--clr-navy);font-size:2.2rem;">
        📦 Chinos S.A. de C.V.
    </h1>
    <p style="color:var(--clr-muted);font-size:1.05rem;">
        Sistema de gestión empresarial
    </p>
    <div class="d-flex justify-content-center gap-2 mt-2 flex-wrap">
        <span class="badge-erp-gold">Inventario</span>
        <span class="badge-erp-gold">Ventas</span>
        <span class="badge-erp-gold">Reportes</span>
    </div>
</div>

<div class="row g-3 mt-2">
    {% for m in modulos %}
    <div class="col-md-4">
        <div class="erp-card text-center"
             style="cursor:pointer;" onclick="Turbo.visit('{{ m.url }}')">
            <div style="font-size:2rem;margin-bottom:.4rem;">{{ m.icono }}</div>
            <strong style="color:var(--clr-navy);">{{ m.nombre }}</strong>
            <p style="color:var(--clr-muted);font-size:.85rem;margin:.3rem 0 0;">
                {{ m.descripcion }}
            </p>
        </div>
    </div>
    {% endfor %}
</div>

<!-- Reproductor de Spotify (esquina inferior derecha) -->
<div id="spotify-player"
     style="position:fixed; bottom:16px; right:16px; z-index:1050; width:300px;">

    <!-- Botón minimizar / mostrar -->
    <div style="text-align:right; margin-bottom:4px;">
        <button id="spotify-toggle" type="button"
                onclick="Turbo.visit('{{ m.url }}')"
                style="background:var(--clr-navy,#1f2a44); color:#fff; border:none;
                       border-radius:20px; padding:2px 12px; font-size:.8rem;
                       cursor:pointer; box-shadow:0 2px 8px rgba(0,0,0,.25);">
            🎵 Ocultar
        </button>
    </div>

    <div id="spotify-frame"
         style="border-radius:12px; overflow:hidden;
                box-shadow:0 4px 16px rgba(0,0,0,.25);">
        <iframe
            src="https://open.spotify.com/embed/track/6RcAHyC5sAUIbPTkhOQwd8?utm_source=generator"
            width="100%" height="80" frameborder="0"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            style="border-radius:12px; display:block;">
        </iframe>
    </div>
</div>

<script>
function toggleSpotify() {
    const frame = document.getElementById('spotify-frame');
    const btn = document.getElementById('spotify-toggle');
    const oculto = frame.style.display === 'none';
    frame.style.display = oculto ? 'block' : 'none';
    btn.textContent = oculto ? '🎵 Ocultar' : '🎵 Mostrar';
}
</script>
{% endblock %}